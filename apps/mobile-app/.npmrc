# Expo pins React to a specific patch (e.g. 19.1.0); some JS-only deps (the AI
# SDK) declare a strict peer like `react ~19.1.2` that doesn't match Expo's pin
# even though the APIs are compatible. `legacy-peer-deps` skips that strict
# peer check so `npm install` resolves — the standard Expo workaround.
legacy-peer-deps=true