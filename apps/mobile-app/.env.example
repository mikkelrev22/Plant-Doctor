# Plant-Doctor mobile app env vars.
# Expo inlines EXPO_PUBLIC_* vars at build time and exposes them to the client.
#
# Two-file setup — no manual switching between local dev and publishing:
#   1. Copy this file to `.env` and set PRODUCTION values. `eas update` and
#      `eas build` use this (both force NODE_ENV=production).
#   2. Create `.env.development.local` (gitignored via `.env*.local`) with your
#      LOCAL dev values — e.g. the backend's LAN IP for Expo Go on a device.
#      `expo start` / `nx serve` use it (NODE_ENV=development); `eas update`
#      never loads it, so a LAN IP can't leak into a publish.
# Do NOT put a LAN IP in `.env.local` — that file loads in ALL environments.

# Base URL of the Node backend (apps/backend).
# - Web / iOS Simulator: http://localhost:4100 works (shares the host network).
# - Expo Go on a physical device: use the dev machine's LAN IP, e.g.
#   http://192.168.1.50:4100  (also set the backend's BACKEND_URL to the same
#   LAN IP so the image URLs it returns are reachable from the phone).
#   Put this LAN URL in `.env.development.local`, not in `.env`.
EXPO_PUBLIC_API_URL=http://localhost:4100

# Static API key sent as the `x-api-key` header on every request. Must match the
# backend's BACKEND_API_KEY. NOTE: this value is bundled into the client and is
# therefore NOT secret — it's the same stopgap gate the web frontends use, fine
# for the single-user prototype but not real auth.
EXPO_PUBLIC_BACKEND_API_KEY=