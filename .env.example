# Api keys
LLM_API_KEY=

# LLM / embeddings / vector store (backend-py)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_URL=sqlite://./data/vector_store.db
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_URL=sqlite://./data/checkpoints.db
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=plant-doctor
REACT_RECURSION_LIMIT=25

# Server bind (backend only — not exposed to browser)
HOST=localhost
PORT=4100

# Python backend (backend-py)
BACKEND_PY_PORT=4200

# PostgreSQL
DATABASE_URL=postgres://plant_doctor:plant_doctor@localhost:5432/plant_doctor

# Public URLs — shared across frontend + backend
FRONTEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:4100
BACKEND_PY_URL=http://localhost:4200
