# Api keys
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=
LLM_API_EMBEDDING=

# LLM / embeddings / vector store (backend-py)
VECTOR_STORE_URL=sqlite://./data/vector_store.db
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_URL=sqlite://./data/checkpoints.db
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=plant-doctor
REACT_RECURSION_LIMIT=25

# Server bind (backend only — not exposed to browser)
# Use 0.0.0.0 in Docker so sibling containers (e.g. Caddy) can reach the backend.
HOST=localhost
PORT=4100

# Python backend (backend-py)
BACKEND_PY_PORT=4200

# PostgreSQL
DATABASE_URL=postgres://plant_doctor:plant_doctor@localhost:5432/plant_doctor

# Public URLs — shared across frontend + backend
FRONTEND_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:4500
BACKEND_URL=http://localhost:4100
BACKEND_PY_URL=http://localhost:4200
ARCHITECTURE_URL=http://localhost:4600

# Local preview uploads
UPLOAD_DIR=uploads/plant-photos

# File storage backend
#   local — write to UPLOAD_DIR and serve via @fastify/static (default; dev)
#   s3    — upload to S3 and serve public URLs (staging/prod)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Optional key prefix, e.g. 'staging/'
S3_PREFIX=
# Optional public base URL; defaults to https://<S3_BUCKET>.s3.<S3_REGION>.amazonaws.com
S3_PUBLIC_BASE_URL=
