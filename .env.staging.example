# Staging deployment config (EC2 + Docker Compose).
# Copy this file to .env on the EC2 host and fill in the values. Do NOT commit .env.
# Variables with ${VAR} in docker-compose.yml are read from this file.

# --- Domain + TLS (Caddy auto-provisions a Let's Encrypt cert) ---
DOMAIN=staging.example.com

# --- PostgreSQL (used by the db, migrate, and backend services) ---
POSTGRES_USER=plant_doctor
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=plant_doctor
# NOTE: DATABASE_URL is constructed by docker-compose from the values above
# (host=db) — you do not need to set it here.

# --- Backend ---
HOST=0.0.0.0
PORT=4100
BACKEND_URL=https://staging.example.com
# Static API key checked against the `x-api-key` header (fail-closed if empty).
# Set a strong value (openssl rand -hex 32) and use the SAME value when building
# the dashboard + architecture frontends — it's baked into their JS bundles.
BACKEND_API_KEY=
# CORS allowlist — set to the real origins of any web clients, or leave as
# defaults if only the mobile app talks to the backend (native apps ignore CORS).
FRONTEND_URL=https://staging.example.com
DASHBOARD_URL=http://localhost:4500
ARCHITECTURE_URL=http://localhost:4600

# --- LLM ---
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=120000
# 'none' = disable Qwen3 thinking (fast, fine for structured JSON);
# 'low' | 'medium' | 'high' = re-enable reasoning.
LLM_REASONING_EFFORT=none

# --- File storage (S3, public-read bucket) ---
STORAGE_DRIVER=s3
S3_BUCKET=plant-doctor-staging-uploads
S3_REGION=us-east-1
S3_PREFIX=staging/
# Optional: override the public URL base (e.g. a CloudFront domain). Leave empty
# to use the default https://<S3_BUCKET>.s3.<S3_REGION>.amazonaws.com
S3_PUBLIC_BASE_URL=
# AWS credentials are NOT needed here — the backend uses the IAM role attached
# to the EC2 instance (instance profile) via the SDK's default credential chain.